<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/styles.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
  <title>Yap Sessions</title>
</head>
<body>
  <header class="chat-header">
    <h2 class="app-title">Yap Sessions</h2>

    <nav class="room-nav">
      <ul id="room-buttons" class="room-list">
        <% Object.keys(rooms).forEach((room) => { %>
          <li><button><%= room %></button></li>
        <% }) %>
      </ul>
    </nav>

    <form action="/logout?_method=DELETE" method="POST" class="logout-form">
      <button type="submit" class="logout-button">
        <i class="fas fa-sign-out-alt"></i> Log Out
      </button>
    </form>
  </header>

  <div class="main">
    <div class="chat-toolbar">
      <div class="name-badge">
        You:
        <input type="text" id="name-input" class="name-input" value="<%= name %>" maxlength="20" readonly />
      </div>
      <h3 class="clients-total" id="clients-total">Total Clients: 0</h3>
    </div>

    <ul class="message-container" id="message-container"></ul>
  </div>

  <form class="message-form" id="message-form">
    <div class="emoji-wrapper">
      <button type="button" id="emoji-button" class="icon-button emoji-btn" title="Emoji">😊</button>
      <div id="emoji-container" class="emoji-popover" style="display: none"></div>
    </div>

    <input type="text" name="message-input" id="message-input" class="message-input" placeholder="Type a message..." required />

    <input type="file" id="file-input" class="file-input" />
    <button type="button" id="upload-button" class="icon-button upload-button" title="Upload file">
      <i class="fas fa-paperclip"></i>
    </button>

    <button type="submit" class="icon-button send-button" title="Send">
      <i class="fas fa-paper-plane"></i>
    </button>
  </form>

  <script type="module" src="https://cdn.jsdelivr.net/npm/emoji-picker-element@1.6.2/index.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.28.0/moment.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>
  <script src="/main.js"></script>
</body>
</html>
